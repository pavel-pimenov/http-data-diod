# NATS Authentication
# Generate token:  openssl rand -hex 32
NATS_TOKEN=your-secret-token-here

# NATS TLS (optional — enables encryption)
# Generate self-signed certs:
#   mkdir -p certs_nats && chmod 700 certs_nats
#   openssl genpkey -algorithm RSA -out certs_nats/ca.key -pkeyopt rsa_keygen_bits:2048
#   openssl req -x509 -new -key certs_nats/ca.key -days 365 -out certs_nats/ca.crt \
#     -subj "/C=RU/O=Test/CN=NATS CA" -nodes
#   openssl genpkey -algorithm RSA -out certs_nats/server.key -pkeyopt rsa_keygen_bits:2048
#   openssl req -new -key certs_nats/server.key -out certs_nats/server.csr \
#     -subj "/C=RU/O=Test/CN=nats-server" -nodes
#   openssl x509 -req -in certs_nats/server.csr -CA certs_nats/ca.crt -CAkey certs_nats/ca.key \
#     -CAcreateserial -out certs_nats/server.crt -days 365 \
#     -extfile <(printf "subjectAltName=DNS:nats-server,DNS:localhost,IP:127.0.0.1")
#   rm -f certs_nats/*.csr certs_nats/*.srl
#   chmod 600 certs_nats/*.key
NATS_ENABLE_TLS=true
# Path to CA certificate inside container (for self-signed certs)
NATS_TLS_CA_CERT_FILE=/etc/nats/certs_nats/ca.crt

# NATS messaging endpoints
NATS_HOST=nats-server
NATS_PORT=4222
NATS_SUBJECT=service.proxy
NATS_QUEUE_GROUP=proxy_workers
NATS_TIMEOUT_MS=30000

# NATS TLS (server certificate/key for the client, optional)
NATS_TLS_CERT_FILE=
NATS_TLS_KEY_FILE=

# HTTP/HTTPS server options
SSL_SERVER_CERT_FILE=
SSL_SERVER_KEY_FILE=

# Tuning
HTTP_POOL_SIZE=100
L2_WORKER_THREADS=128
# Worker thread pool queue bound (0 = auto: threads * 8)
L2_WORKER_QUEUE_SIZE=0
ENABLE_PER_IP_RATE_LIMITING=false

# Test-only: random response delay in ms on l2-server (0 = disabled).
# Used by the response-to-request correlation test to exercise response mixing.
L2_TEST_RESPONSE_DELAY_MS=0

# Logging
# Log verbosity: DEBUG / INFO / WARN / ERROR (default INFO)
LOG_LEVEL=INFO
# Log format: text (human-readable, default) or json (structured, used by l2-proxy)
LOG_FORMAT=text

# Debug/diagnostics (default off)
# Enable the HTTP /crash-test endpoint on l2-proxy (used by test-crash-handler.py)
ENABLE_CRASH_TEST_ENDPOINT=false
# Allow /health/ready to initiate a blocking NATS reconnect (default off = fast non-blocking health)
HEALTH_READY_ALLOW_CONNECT=false

# Build args (optional, for developers)
# BASE_IMAGE=ubuntu:26.04
# APT_MIRROR=
# CACHE_BUST=1
# L2_PROXY_DOCKER_TARGET=runtime
# USE_GZIP_HTTP_DATA_DIOD=false
# ENABLE_ASAN=false
# ENABLE_PROFILER=false
