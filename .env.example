# NATS Authentication
# Generate token:  openssl rand -hex 32
NATS_TOKEN=your-secret-token-here

# NATS TLS (optional — enables encryption)
# Generate self-signed certs:
#   mkdir -p certs_nats && chmod 700 certs_nats
#   openssl genpkey -algorithm RSA -out certs_nats/ca.key -pkeyopt rsa_keygen_bits:2048
#   openssl req -x509 -new -key certs_nats/ca.key -days 365 -out certs_nats/ca.crt \
#     -subj "/C=RU/O=Test/CN=NATS CA" -nodes
#   openssl genpkey -algorithm RSA -out certs_nats/server.key -pkeyopt rsa_keygen_bits:2048
#   openssl req -new -key certs_nats/server.key -out certs_nats/server.csr \
#     -subj "/C=RU/O=Test/CN=nats-server" -nodes
#   openssl x509 -req -in certs_nats/server.csr -CA certs_nats/ca.crt -CAkey certs_nats/ca.key \
#     -CAcreateserial -out certs_nats/server.crt -days 365 \
#     -extfile <(printf "subjectAltName=DNS:nats-server,DNS:localhost,IP:127.0.0.1")
#   rm -f certs_nats/*.csr certs_nats/*.srl
#   chmod 600 certs_nats/*.key
NATS_ENABLE_TLS=true
# Path to CA certificate inside container (for self-signed certs)
NATS_TLS_CA_CERT_FILE=/etc/nats/certs_nats/ca.crt

# NATS messaging endpoints
NATS_HOST=nats-server
NATS_PORT=4222
NATS_SUBJECT=service.proxy
NATS_QUEUE_GROUP=proxy_workers
NATS_TIMEOUT_MS=30000
NATS_CONNECT_TIMEOUT_MS=5000

# NATS TLS (server certificate/key for the client, optional)
NATS_TLS_CERT_FILE=
NATS_TLS_KEY_FILE=

# HTTP/HTTPS server options
SSL_SERVER_CERT_FILE=
SSL_SERVER_KEY_FILE=

# Upstream backend (worker). Defaults to the bundled l2-server test stub.
L2_SERVER_PROTOCOL=http
L2_SERVER_HOST=l2-server
L2_SERVER_PORT=8088
# Optional JSON array of allowed upstreams. ODS-цепочка (DataHub/GantPool) задаёт:
#   L2_SERVER_URLS=["https://odskc2.nlmk:8181/DataHubRobots/DataHubSrv", "https://odskc2.nlmk:8181/GantPool/GetGantDescr"]
L2_SERVER_URLS=
# l2-heat-scraper: перебор плавок GetHeatData через прокси-цепочку.
# Креды ODS (секреты — только в .env): Basic user/password + X-DataHub-Client-Id.
HEAT_SCRAPE_URL=http://nl-sp-p3pg-ad1.ao.nlmk:29003/DataHubRobots/DataHubSrv
HEAT_SCRAPE_USER=
HEAT_SCRAPE_PASSWORD=
HEAT_SCRAPE_CLIENT_ID=
HEAT_SCRAPE_START=23143
HEAT_SCRAPE_COUNT=100
HEAT_SCRAPE_OUTPUT_DIR=./heat-output
# l2-heat-ai: веб-сервер AI-генерации отчёта по плавкам (порт 19097).
# Читает heat_*.json из ./heat-output, агрегирует и шлёт AI-модели.
HEAT_AI_PORT=19097
HEAT_AI_MAX_HEATS=500

# Forward non-JSON / zlib-compressed request bodies instead of rejecting them
# with HTTP 400. Bodies are base64-encoded in the NATS envelope and decoded
# byte-for-byte by the worker. Disabled by default: the bundled l2-server stub
# speaks JSON; an external binary upstream enables this.
PROXY_RAW_BODY_PASSTHROUGH=false

# Tuning
HTTP_POOL_SIZE=100
HTTP_POOL_IDLE_TIMEOUT_SECONDS=300
L2_WORKER_THREADS=128
# Worker thread pool queue bound (0 = auto: threads * 8)
L2_WORKER_QUEUE_SIZE=0
ENABLE_PER_IP_RATE_LIMITING=true
PER_IP_MAX_TOKENS=10000
PER_IP_REFILL_RATE=1000
PER_IP_MAX_IPS=10000
PER_IP_CLEANUP_TTL_SECONDS=300
ENABLE_GLOBAL_RATE_LIMITING=true
GLOBAL_RATE_LIMIT_MAX_TOKENS=10000
GLOBAL_RATE_LIMIT_REFILL_RATE=1000

# HTTP DB Gateway (NATS subject service.db.query)
# DB engines (postgres/oracle in docker-compose.yml) are gated behind the
# `databases` compose profile and normally live on a dedicated DB node:
#   docker compose --profile databases up -d          # на узле-БД
# The worker here reaches them via DB_*_HOST — set it to the DB node address,
# not to the local compose service name.
DB_QUERY_ENABLED=true
DB_QUERY_NATS_TIMEOUT_MS=30000
DB_QUERY_DEFAULT_TIMEOUT_MS=5000
DB_QUERY_DEFAULT_MAX_ROWS=1000
DB_POSTGRES_ENABLED=true
# DB_POSTGRES_HOST=<адрес узла-БД или postgres при локальном запуске>
DB_POSTGRES_HOST=postgres
DB_POSTGRES_PORT=5432
DB_POSTGRES_DB=app_db
DB_POSTGRES_USER=app_user
# DB_POSTGRES_PASSWORD=app_password
DB_POSTGRES_POOL_MIN=1
DB_POSTGRES_POOL_MAX=5
# Oracle требует worker target runtime-db (см. rebuild-and-run.sh) —
# L2_WORKER_DOCKER_TARGET=runtime-db
# В окружении с внешней Oracle БД: DB_ORACLE_ENABLED=true + внешний
# DB_ORACLE_HOST (напр. ccm3t.nlmk), а postgres можно отключить.
DB_ORACLE_ENABLED=false
# DB_ORACLE_HOST=<адрес узла-БД или oracle при локальном запуске>
DB_ORACLE_HOST=oracle
DB_ORACLE_PORT=1521
DB_ORACLE_SERVICE=XEPDB1
DB_ORACLE_USER=app_user
# DB_ORACLE_PASSWORD=app_password
DB_ORACLE_POOL_MIN=1
DB_ORACLE_POOL_MAX=5

# l2-db-spider: периодический опрос баз данных (Oracle/PostgreSQL)
# произвольными SELECT-запросами и выгрузка в JSON-файл.
# Конфиг — INI-файл (см. spider-config.ini): секции [spider], [db:<имя>] и
# [query:<имя>] (запрос привязывается к базе через db=<имя>). Каждый запрос
# пишется в отдельный файл <db>_<query>.json в DB_SPIDER_OUTPUT_DIR.
# Oracle требует таргета runtime-db (как и l2-worker): L2_WORKER_DOCKER_TARGET=runtime-db
DB_SPIDER_ENABLED=false
DB_SPIDER_INTERVAL_SECONDS=300
DB_SPIDER_OUTPUT_DIR=/spider
DB_SPIDER_CONFIG_FILE=/spider/spider-config.ini
# Пароль баз, опрашиваемых l2-db-spider. Значение подставляется в
# spider-config.ini на место placeholder %DB_SPIDER_PASSWORD%. Не храните
# реальный пароль в .env.example — задайте его в .env (не в git).
DB_SPIDER_PASSWORD=
# Пользователь баз ccm2/ccm4/ccm5 (общий, подставляется на место
# %DB_SPIDER_USER_CCM2% / %DB_SPIDER_USER_CCM4% / %DB_SPIDER_USER_CCM5%).
DB_SPIDER_USER_CCM2=
DB_SPIDER_USER_CCM4=
DB_SPIDER_USER_CCM5=
# Пользователь/пароль per-db для баз bfm/mes/energy/kkc1ccy/kkc2ccy/nmes
# (секреты; подставляются на место %DB_SPIDER_USER_<ИМЯ>%/%DB_SPIDER_PASSWORD_<ИМЯ>%).
DB_SPIDER_USER_BFM=
DB_SPIDER_PASSWORD_BFM=
DB_SPIDER_USER_MES=
DB_SPIDER_PASSWORD_MES=
DB_SPIDER_USER_ENERGY=
DB_SPIDER_PASSWORD_ENERGY=
DB_SPIDER_USER_KKC1CCY=
DB_SPIDER_PASSWORD_KKC1CCY=
DB_SPIDER_USER_KKC2CCY=
DB_SPIDER_PASSWORD_KKC2CCY=
DB_SPIDER_USER_NMES=
DB_SPIDER_PASSWORD_NMES=
# Общие системные SELECT-запросы вынесены в spider-sql/*.sql (ключ sql_file в
# spider-config.ini); каталог spider-sql монтируется в контейнер рядом с ini.

# De-duplication (NATS reply lost during reconnect)
DEDUP_ENABLED=false
DEDUP_MAX_ENTRIES=4096
DEDUP_TTL_MS=60000
DUPLICATE_DETECTION_ENABLED=true
DUPLICATE_DETECTION_TOP_N=100
DUPLICATE_DETECTION_MAX_ENTRIES=1000
DUPLICATE_DETECTION_MAX_BODY_BYTES=500
DUPLICATE_DETECTION_TTL_MS=60000
DUPLICATE_LOG_THRESHOLD=5
DUPLICATE_DETECTION_MAX_CLIENTS=1000
DUPLICATE_DETECTION_CLIENT_TTL_MS=1800000
DUPLICATE_REJECT_ENABLED=false

# Tracing
ENABLE_TRACING=true
TRACING_BATCH_SIZE=50
TRACING_FLUSH_INTERVAL_MS=1000
TRACING_SAMPLE_RATE=1.0
JAEGER_URL=http://jaeger:9411/api/v2/spans

# Sentry/GlitchTip error tracking (self-hosted Sentry-compatible, порт 8000).
# GlitchTip всегда в стеке; после первого запуска зарегистрируй юзера в
# http://localhost:8000, создай организацию + проект и подставь DSN проекта:
#   SENTRY_DSN=http://<public-key>@glitchtip:8000/<project-id>
# Пустой DSN = интеграция выключена (события не шлются).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TIMEOUT_MS=3000
SENTRY_MAX_QUEUE_SIZE=2000

# Test-only: random response delay in ms on l2-server (0 = disabled).
# Used by the response-to-request correlation test to exercise response mixing.
L2_TEST_RESPONSE_DELAY_MS=0

# Logging
# Log verbosity: DEBUG / INFO / WARN / ERROR (default INFO)
LOG_LEVEL=INFO
# Log format: text (human-readable, default) or json (structured, used by l2-proxy)
LOG_FORMAT=text

# Debug/diagnostics (default off)
# Enable the HTTP /crash-test endpoint on l2-proxy (used by test-crash-handler.py)
ENABLE_CRASH_TEST_ENDPOINT=false
# Allow /health/ready to initiate a blocking NATS reconnect (default off = fast non-blocking health)
HEALTH_READY_ALLOW_CONNECT=false

# VM_NAME: label 'vm' в метриках (vmagent добавляет при скрейпе). Должен быть
# реальным именем узла, НЕ литералом "hostname" — иначе в VictoriaMetrics
# появятся мусорные серии vm=hostname (см. round-212).
VM_NAME=my-node

# Build args (optional, for developers)
#
# Contour proxies — задаются per-conour в своём .env (пусто = Docker Hub /
# distro-дефолт). Дефолт dp.nlmk — пример текущего контура:
#   REGISTRY    prefix for all external container images (e.g. nats, nginx,
#               victoria-metrics, oracle-xe, postgres). Empty = Docker Hub.
#   APT_MIRROR  Ubuntu 26.04 apt repository mirror used inside the images.
#               Empty = distro default sources.
#   PIP_INDEX_URL  pip index for the Python helper images (PDF/dashboards/registry
#               report). Default = internal artifactory; set to https://pypi.org/simple
#               when building outside the closed contour.
# Другие закрытые контуры подставляют свои адреса, напр.:
#   REGISTRY=repo.ia.nlmk/k8s-oci/dockerhub/
#   APT_MIRROR=http://repo.ia.nlmk/artifactory/ubuntu_repo/
# (адреса контуров могут отличаться — смотри документацию контура).
REGISTRY=docker-registry.dp.nlmk.com/
APT_MIRROR=https://repos.dp.nlmk.com/artifactory/archive-ubuntu-remote/
# BASE_IMAGE=ubuntu:26.04
# CACHE_BUST=1
# L2_PROXY_DOCKER_TARGET=runtime
# USE_GZIP_HTTP_DATA_DIOD=false
# ENABLE_ASAN=false
# ENABLE_PROFILER=false
L2_DB_SPIDER_MEM_LIMIT=2048m

# l2-spider-ai: веб-сервер прогресса AI-генерации отчёта по данным l2-db-spider
# (порт 19096). Данные из ./spider-output шлются внешней OpenAI-совместимой
# модели (endpoint + ключ + имя модели), результат — report.md/report.pdf в
# ./spider-output/ai.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# AI_PROVIDER=openai
# AI_TIMEOUT=600
# AI_AI_ROWS=40
# AI_MAX_TOKENS=6000

# Docker-реестры для сервера отчётов (registry-report-server).
# Формат: REGISTRY_<ИМЯ>_URL / REGISTRY_<ИМЯ>_USER / REGISTRY_<ИМЯ>_PASSWORD.
# Учётка read-only на всю репу. Секреты — только в .env, не в git.
# REGISTRY_IA_URSU_URL=ia-ursu-docker-prod.dp.nlmk.com
# REGISTRY_IA_URSU_USER=user
# REGISTRY_IA_URSU_PASSWORD=pass
# REGISTRY_IA_TEST_URL=ia-test-docker-docker.dp.nlmk.com
# REGISTRY_IA_TEST_USER=user
# REGISTRY_IA_TEST_PASSWORD=pass
